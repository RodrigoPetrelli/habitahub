{
  "name": "habitahub-sistema",
  "version": "0.1.0",
  "private": true,
  "description": "HabitaHub – CRUDs com banco de dados, padrões de projeto e variabilidade (LPS)",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "start:lana": "node server.js --produto=lana-mayan",
    "start:autonomo": "node server.js --produto=corretor-autonomo",
    "build": "node scripts/build.js",
    "start:dist": "node scripts/build.js && node server.js --front=dist",
    "medir-reuso": "node scripts/medir-reuso.js",
    "test": "node --test"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
